* text=auto

# Text
*.ini     text
*.uproject text
*.uplugin text
*.cs      text diff=csharp
*.cpp     text diff=cpp
*.h       text diff=cpp
*.usf     text
*.ush     text
*.hlsl    text
*.py      text
